---
import type { CollectionEntry } from "astro:content";
import { Code } from "@astrojs/starlight/components";

interface Props {
	data: CollectionEntry<"docs">["data"];
}

const { data } = Astro.props;
const { system } = data;
const sshFingerprint = system?.sshFingerprint;

const details = new Map<string, string | undefined>([
	["Operativsystem", system?.os],
	["Arkitektur", system?.arch],
	["Modell", system?.model],
	["Processor", system?.cpu],
	["Minne", system?.ram],
	["Grafikkort", system?.gpu],
	["Placering", system?.placement],
	["Namngiven efter", system?.namedAfter],
	["Ansvarig root", system?.admin],
]);

const hasDetails = details.values().some((v) => v);
---

{hasDetails || sshFingerprint ? (
	<div class="sl-markdown-content">
		{hasDetails ? (
			<table>
				<tbody>
					{details.entries().map(([label, value]) =>
						value ? (
							<tr>
								<th scope="row">{label}</th>
								<td>{value}</td>
							</tr>
						) : null,
					)}
				</tbody>
			</table>
		) : null}
		{sshFingerprint && (
			<details>
				<summary>SSH-fingeravtryck</summary>
				<Code code={sshFingerprint} />
			</details>
		)}
	</div>
) : null}
