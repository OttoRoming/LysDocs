---
import { getCollection } from "astro:content";
import { CardGrid, LinkCard } from "@astrojs/starlight/components";
import type { System } from "../content.config";

interface Props {
	filter?: (value: System) => boolean;
}

const { filter } = Astro.props;
const collator = new Intl.Collator("sv", { sensitivity: "base" });

const systems = (await getCollection("docs"))
	.flatMap((entry) => {
		const system = entry.data.system;
		if (!system) return [];
		return [{ entry, system }];
	})
	.filter(({ system }) => (filter ? filter(system) : true))
	.sort((a, b) => collator.compare(a.entry.data.title, b.entry.data.title));

const cards = systems.map(({ entry, system }) => {
	const description = system.os;

	return {
		title: entry.data.title,
		description: description || undefined,
		href: `/${entry.id}/`,
	};
});
---

{cards.length > 0 && (
	<CardGrid>
		{cards.map((card) => (
			<LinkCard
				title={card.title}
				description={card.description}
				href={card.href}
			/>
		))}
	</CardGrid>
)}
