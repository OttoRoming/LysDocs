---
import { getCollection } from "astro:content";
import { CardGrid, LinkCard } from "@astrojs/starlight/components";
import { type SystemCategory, systemCategories } from "../systems";

interface Props {
	category?: SystemCategory;
}

const { category } = Astro.props;
const collator = new Intl.Collator("sv", { sensitivity: "base" });

const systems = (await getCollection("docs"))
	.filter(
		(entry) =>
			entry.data.category !== undefined &&
			(category === undefined || entry.data.category === category),
	)
	.sort((a, b) => collator.compare(a.data.title, b.data.title));

const cards = systems.map((system) => {
	const categoryLabel =
		category === undefined && system.data.category
			? systemCategories[system.data.category]
			: undefined;
	const description = [categoryLabel, system.data.os]
		.filter((value) => value !== undefined)
		.join(" · ");

	return {
		title: system.data.title,
		description: description || undefined,
		href: `/${system.id}/`,
	};
});
---

{cards.length > 0 && (
	<CardGrid>
		{cards.map((card) => (
			<LinkCard
				title={card.title}
				description={card.description}
				href={card.href}
			/>
		))}
	</CardGrid>
)}
