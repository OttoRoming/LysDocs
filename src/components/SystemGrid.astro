---
import { getCollection } from "astro:content";
import { CardGrid, LinkCard } from "@astrojs/starlight/components";
import { type SystemCategory, systemCategories } from "../systems";

interface Props {
	category?: SystemCategory;
}

const { category } = Astro.props;
const collator = new Intl.Collator("sv", { sensitivity: "base" });

const systems = (await getCollection("docs"))
	.flatMap((entry) => {
		const system = entry.data.system;
		if (!system) return [];
		if (category !== undefined && system.category !== category) return [];
		return [{ entry, system }];
	})
	.sort((a, b) => collator.compare(a.entry.data.title, b.entry.data.title));

const cards = systems.map(({ entry, system }) => {
	const categoryLabel =
		category === undefined ? systemCategories[system.category] : undefined;
	const description = [categoryLabel, system.os]
		.filter((value) => value !== undefined)
		.join(" · ");

	return {
		title: entry.data.title,
		description: description || undefined,
		href: `/${entry.id}/`,
	};
});
---

{cards.length > 0 && (
	<CardGrid>
		{cards.map((card) => (
			<LinkCard
				title={card.title}
				description={card.description}
				href={card.href}
			/>
		))}
	</CardGrid>
)}
